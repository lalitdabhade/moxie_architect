# Copy to .env and fill in real values. Never commit .env.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=architect
DB_PASSWORD=change-me
DB_NAME=architect_app
# Separate database used by the test suite (it is wiped by tests)
DB_NAME_TEST=architect_app_test

# Admin account created/updated by: python -m scripts.seed_admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Random secret used to sign the login-form CSRF cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Admin session lifetime in hours
SESSION_HOURS=8
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Optional: where uploads are stored (default: ./uploads)
# UPLOAD_DIR=
